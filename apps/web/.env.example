# Google Cloud service account JSON, pasted whole as a single line (or
# multiline if your shell allows it). The file you download from Google
# Cloud Console → IAM & Admin → Service Accounts → Keys → Add Key → JSON.
#
# Used by the serverless functions in apps/web/api/. Never exposed to the
# client. Replaces the old DRIVE_API_KEY model.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID of the Drive folder containing your audio files. Take it from the
# folder URL: https://drive.google.com/drive/folders/<ID>
# The folder must be shared (Viewer access) with the service account's
# `client_email` from the JSON above.
DRIVE_FOLDER_ID=
